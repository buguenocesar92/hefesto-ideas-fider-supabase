# Copiar a .env SOLO en servidor. No subir a Git.
# Contrato auditable de variables: ninguna tiene valor real.
BASE_URL=https://ideas.tu-dominio.cl
APP_URL=https://ideas.tu-dominio.cl
APP_HOST=ideas.tu-dominio.cl
DB_HOST=db.REEMPLAZAR.supabase.co
DB_NAME=postgres
DB_USER=fider_app
DB_PASSWORD=GENERAR
DB_SSLMODE=require
DB_SSLROOTCERT_QS=&sslrootcert=/certs/ca.crt
JWT_SECRET=GENERAR
